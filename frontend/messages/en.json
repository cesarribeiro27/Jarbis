  "faq": {
    "label": "FAQ",
    "title": "Questions & answers",
    "items": [
      {
        "q": "Do I need to know how to code?",
        "a": "No. Jarbis was built for business owners, not developers. If you can use Excel, you can use Jarbis."
      },
      {
        "q": "Does it work with Google Sheets or Excel?",
        "a": "Yes! You can import Excel and CSV files directly, or connect a Google Sheets spreadsheet via link. Data updates automatically."
      },
      {
        "q": "Is my data secure?",
        "a": "Yes. All data is encrypted and stored on secure servers. No data is shared with third parties."
      },
      {
        "q": "Can I cancel anytime?",
        "a": "Yes, no hassle and no penalty. Cancel directly from your dashboard at any time."
      },
      {
        "q": "What is the free plan?",
        "a": "The free plan lets you create up to 2 dashboards with 2 data sources, with no expiry. It's free forever, no credit card needed."
      },
      {
        "q": "Can I show charts to my clients?",
        "a": "Yes. Generate a public link and send it by email. Your client sees live data without creating an account. On the Unlimited plan, dashboards show your own branding."
      }
    ]
  },
